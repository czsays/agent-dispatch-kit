# Copy to .env and fill in. The app reads these at startup.
# NEVER commit a real .env — only this example belongs in git.

# ---- Webhook intake -------------------------------------------------------

# The HTTP header carrying the hex HMAC-SHA256 of the raw request body.
# Defaults to "x-signature". Set this to match your sender / provider.
WEBHOOK_SIGNATURE_HEADER=x-signature

# The global/fallback signing secret. Used to verify any inbound webhook when
# no persona-specific signing secret is selected. REQUIRED for the app to
# accept anything — an unset secret makes every webhook fail closed (401).
WEBHOOK_SIGNING_SECRET=replace-with-a-long-random-string

# Symmetric replay-window half-width, in seconds. A webhook whose `timestamp`
# is more than this far from now (past OR future) is rejected. Default 60.
WEBHOOK_REPLAY_WINDOW_SECONDS=60

# Max request-body bytes the handler will read before returning 413. Default 1 MiB.
WEBHOOK_MAX_BODY_BYTES=1048576

# route/<name> -> backend map, as comma-separated `name:backend` pairs. Unset =>
# the reference defaults (echo:echo,log:log). An event carrying a single
# `route/<name>` label routes to the mapped backend.
WEBHOOK_LABEL_ROUTES=echo:echo,log:log

# Max depth of the in-memory async queue between the ack handler and the worker.
# Saturated => the handler returns 503 (backpressure), not a silent drop.
DISPATCH_QUEUE_MAX=128

# ---- Persona secrets (referenced by personas.yaml) ------------------------
# personas.yaml holds the env-var NAMES; the values live here. A persona whose
# referenced vars are unset loads `available=False` (fail-closed) but keeps its
# identity, so routing still resolves. Set these to make the placeholder
# personas live.

RESPONDER_API_TOKEN=
RESPONDER_WEBHOOK_SECRET=

LOGGER_API_TOKEN=
LOGGER_WEBHOOK_SECRET=

COORDINATOR_API_TOKEN=
COORDINATOR_WEBHOOK_SECRET=

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
